import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

# Display settings
pd.set_option('display.max_columns', None)
plt.style.use('default')

# Load dataset
df = pd.read_csv("../data/top_rated_2000webseries.csv")

# Preview data
df.head()

# Shape of dataset
df.shape

# Column info
df.info()

# Check missing values
df.isnull().sum().sort_values(ascending=False)

df['rating'].describe()

plt.figure()
sns.histplot(df['rating'], bins=20, kde=True)
plt.title("Distribution of TV Show Ratings")
plt.xlabel("Rating")
plt.ylabel("Count")
plt.show()

numeric_cols = ['popularity', 'votes']

df[numeric_cols].describe()

for col in numeric_cols:
    plt.figure()
    sns.histplot(df[col], bins=30, kde=True)
    plt.title(f"Distribution of {col}")
    plt.show()

# Correlation with rating
df[['rating', 'popularity', 'votes']].corr()

plt.figure()
sns.scatterplot(x='popularity', y='rating', data=df)
plt.title("Popularity vs Rating")
plt.show()

plt.figure()
sns.scatterplot(x='votes', y='rating', data=df)
plt.title("Votes vs Rating")
plt.show()

# Split multi-genre entries
genres = df['genre'].dropna().str.split(', ')

# Flatten genre list
all_genres = [g for sublist in genres for g in sublist]

genre_counts = pd.Series(all_genres).value_counts()

genre_counts.head(10)

plt.figure(figsize=(10,5))
genre_counts.head(10).plot(kind='bar')
plt.title("Top 10 Genres")
plt.xlabel("Genre")
plt.ylabel("Count")
plt.show()

# Average rating by genre
genre_ratings = {}

for genre in genre_counts.index:
    mask = df['genre'].str.contains(genre, na=False)
    genre_ratings[genre] = df.loc[mask, 'rating'].mean()

genre_ratings = pd.Series(genre_ratings).sort_values(ascending=False)
genre_ratings.head(10)

df['country_origin'].value_counts().head(10)

df['original_language'].value_counts().head(10)

# Average rating by language (top 10)
lang_rating = (
    df.groupby('original_language')['rating']
      .mean()
      .sort_values(ascending=False)
)

lang_rating.head(10)

# Overview length
df['overview_length'] = df['overview'].astype(str).apply(len)

df['overview_length'].describe()

plt.figure()
sns.histplot(df['overview_length'], bins=30, kde=True)
plt.title("Overview Text Length Distribution")
plt.xlabel("Character Count")
plt.show()

# Correlation between overview length and rating
df[['rating', 'overview_length']].corr()

df.isnull().mean().sort_values(ascending=False)

### Key EDA Insights
- Ratings have low variance, making prediction challenging
- Popularity and votes correlate weakly but consistently with ratings
- Genres show noticeable differences in average ratings
- Language and country introduce global diversity
- Overview text length varies widely and may capture narrative depth

These insights inform feature engineering and model selection in the next stage.
